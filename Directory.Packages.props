<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CoreLibVersion>10.0.14</CoreLibVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.* -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(CoreLibVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(CoreLibVersion)" />

    <!-- AWS (HkdfGuard.KeyWrapping.AwsKms, HkdfGuard.Cache.AwsSecretsManager, HkdfGuard.Pipeline.AwsSecretsManager) -->
    <PackageVersion Include="AWSSDK.KeyManagementService" Version="4.0.101.2" />
    <PackageVersion Include="AWSSDK.SecretsManager" Version="4.0.100.23" />

    <!-- Azure (HkdfGuard.KeyWrapping.AzureKeyVault, HkdfGuard.Cache.AzureKeyVault, HkdfGuard.Pipeline.AzureKeyVault; Azure.Identity for their integration tests only) -->
    <PackageVersion Include="Azure.Security.KeyVault.Keys" Version="4.10.2" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />

    <!-- Google Cloud (HkdfGuard.KeyWrapping.GoogleKms, HkdfGuard.Cache.GoogleSecretManager, HkdfGuard.Pipeline.GoogleSecretManager) -->
    <PackageVersion Include="Google.Cloud.Kms.V1" Version="3.27.0" />
    <PackageVersion Include="Google.Cloud.SecretManager.V1" Version="3.0.0" />

    <!-- ConfigurationResolver (HkdfGuard.Integration.ConfigurationResolver) -->
    <PackageVersion Include="ConfigurationResolver" Version="0.9.1" />

    <!-- Test infrastructure -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />

    <!-- Benchmark infrastructure -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
