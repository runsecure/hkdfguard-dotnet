<?xml version="1.0" encoding="utf-8"?>
<!--
  Restores only from nuget.org, whatever sources a developer's or build agent's machine-wide
  configuration adds: <clear/> drops them, and package source mapping pins every package ID to
  nuget.org, so a same-named package on any other feed can never be substituted.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
