<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HkdfGuard.KeyWrapping.V1.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HkdfGuard.Abstractions\HkdfGuard.Abstractions.csproj" />
    <ProjectReference Include="..\HkdfGuard.Diagnostics\HkdfGuard.Diagnostics.csproj" />
  </ItemGroup>

  <!--
    No native library is packed into this package. Each platform's native KMS library is installed
    separately, to a fixed location, and loaded only from there after verification:
      Windows: %ProgramFiles%\HkdfGuard\v1\HkdfGuard.dll        (WindowsNativeLibraryLoader)
      macOS:   /Library/Application Support/HkdfGuard/v1/libhkdfguard.dylib, or
               ~/.hkdfguard/v1/libhkdfguard.dylib               (MacOsNativeLibraryLoader)
      Linux:   /usr/lib/<multiarch>/libhkdfguard.so.1, or
               /usr/lib64/libhkdfguard.so.1 (libhkdfguard1 package) (LinuxNativeLibraryLoader)
  -->

</Project>
